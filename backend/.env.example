# Optional. Uploads are disabled and return 503 until all four are set.
# S3_ENDPOINT is only needed for S3-compatible services (MinIO, R2).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
